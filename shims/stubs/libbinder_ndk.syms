# libbinder_ndk symbols our shims link against (name@version node, as on the phone). shims/build.sh builds a
# link-only stub libbinder_ndk.so from this list; the real library comes from the phone's /system at runtime.
ABinderProcess_joinThreadPool@LIBBINDER_NDK
ABinderProcess_setThreadPoolMaxThreadCount@LIBBINDER_NDK
ABinderProcess_startThreadPool@LIBBINDER_NDK
AIBinder_Class_define@LIBBINDER_NDK
AIBinder_DeathRecipient_new@LIBBINDER_NDK
AIBinder_associateClass@LIBBINDER_NDK
AIBinder_decStrong@LIBBINDER_NDK
AIBinder_linkToDeath@LIBBINDER_NDK
AIBinder_markVintfStability@LIBBINDER_NDK30
AIBinder_new@LIBBINDER_NDK
AIBinder_prepareTransaction@LIBBINDER_NDK
AIBinder_setExtension@LIBBINDER_NDK30
AIBinder_transact@LIBBINDER_NDK
AParcel_appendFrom@LIBBINDER_NDK31
AParcel_delete@LIBBINDER_NDK
AParcel_getDataPosition@LIBBINDER_NDK
AParcel_getDataSize@LIBBINDER_NDK31
AParcel_readInt32@LIBBINDER_NDK
AParcel_readStatusHeader@LIBBINDER_NDK
AParcel_readStrongBinder@LIBBINDER_NDK
AParcel_setDataPosition@LIBBINDER_NDK
AParcel_writeByte@LIBBINDER_NDK
AParcel_writeInt32@LIBBINDER_NDK
AParcel_writeStatusHeader@LIBBINDER_NDK
AParcel_writeString@LIBBINDER_NDK
AParcel_writeStrongBinder@LIBBINDER_NDK
AServiceManager_addService@LIBBINDER_NDK
AServiceManager_waitForService@LIBBINDER_NDK31
AStatus_delete@LIBBINDER_NDK
AStatus_fromExceptionCode@LIBBINDER_NDK
AStatus_isOk@LIBBINDER_NDK
AStatus_newOk@LIBBINDER_NDK
